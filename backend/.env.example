# Copy this file to .env (same folder) and fill in your key. .env is never uploaded to GitHub.

# Free key from Google AI Studio: https://aistudio.google.com/apikey (starts with AQ. or AIza)
GEMINI_API_KEY=

# Which Gemini model to use. If it stops answering, run: python tools/test_gemini.py
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: seconds to wait for Gemini before using the rule-based answer.
GEMINI_TIMEOUT=90

# Optional: path to the front-end folder (Adeline's repo) so one command serves everything.
# Example: FRONTEND_DIR=../../uw-schedule-chatbot-ai-collective-project
FRONTEND_DIR=
